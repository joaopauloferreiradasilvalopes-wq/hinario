{
  "title": "62 - En presencia estar de Cristo",
  "author": "Carrie Ellis Breck Grant Colfaxtullar",
  "speed": 1,
  "verses": [
    [
      "1. En presencia estar de Cristo,",
      "Ver Su rostro ¿que será,",
      "Cuando al fin, en pleno gozo,",
      "M i alma le contemplará?  "
    ],
    [
      "2. Sólo tras oscuro velo",
      "Hoy lo puedo aquí mirar,",
      "Pero pronto viene el día",
      "Que su gloria ha de mostrar."
    ],
    [
      "3. ¡Cuanto gozo habrá con Cristo",
      "Cuando no haya más dolor,",
      "Cuando cesen los peligros",
      "Al abrigo de su amor!"
    ],
    [
      "4. Cara a cara, qué alegría",
      "Será vivir así,",
      "Ver el rostro tan querido",
      "¡Que murió por mí!"
    ]
  ],
  "coro": [
      "Cara a cara espero verle",
      "cuando venga en gloria y luz;",  
      "cara a cara allá en el cielo",
      "he de ver a mi Jesús.",
  ],
  "audioFilters": {
    "gain": 1.2,
    "bass": 0,
    "mid": -5,
    "treble": 12
  },
  "introducao": 0
}
